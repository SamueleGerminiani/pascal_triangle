NAME=pascal
CFLAGS=-Wall -std=c99
INCLUDE=-I./include
SRCS=src/main.c src/triangle.c src/printer.c src/vault.c

OBJS=$(SRCS:.c=.o)

$(NAME): $(OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o build/$@

%.o : %.c
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDE) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDE) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: clean

clean:
	@rm -f src/*.o $(NAME)
	@rm -f build/$(NAME)
	@echo "Removed object files and executable..."
